# Copy to .env.local for `next dev`. Every value is optional locally; see README for what each enables.

# Public URL of this deployment (SIWS uri, link pages, Actions). SIWS_DOMAIN defaults to its host.
PUBLIC_BASE_URL=http://localhost:3000
# SIWS_DOMAIN=localhost:3000

# HS256 session secret, 32+ chars. Required in production.
JWT_SECRET=

# Postgres. Unset = embedded PGlite (in memory, or on disk with PGLITE_DIR).
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# DATABASE_CA_CERT=
# PGLITE_DIR=.pglite

# RPC. With HELIUS_API_KEY both clusters use Helius; otherwise public endpoints (or these overrides).
HELIUS_API_KEY=
# DEVNET_RPC_URL=
# MAINNET_RPC_URL=

# Server keypairs: inline (JSON byte array or base58) or a file path.
FAUCET_KEYPAIR_PATH=../../keys/faucet.json
CRANK_KEYPAIR_PATH=../../keys/crank.json
MINT_AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
# FAUCET_KEYPAIR=
# CRANK_KEYPAIR=
# MINT_AUTHORITY_KEYPAIR=

# Shared secrets for the cron tick and the Helius webhook.
CRON_SECRET=
HELIUS_WEBHOOK_SECRET=

# FCM HTTP v1 service account (the whole JSON on one line). Unset = pushes are logged and skipped.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Android App Links.
ANDROID_PACKAGE=app.getbao
ANDROID_CERT_SHA256=

# Devnet deployment (defaults come from packages/sdk/src/devnet.json).
# GENESIS_GROUP=BuRJQxYkL43H3MmgmZmRuC1GCDFc1hSkEu2t1mxiDgwK
# TSKR_MINT=aveV2LBQt6Bck1nsju3md5k223uxQNULjDvW6QcmCCr
# FAUCET_SOL_LAMPORTS=50000000
# FAUCET_TSKR_UNITS=1000000000
# INDEXER_BACKFILL_LIMIT=200

# House rain: the crank drops a public packet from the faucet key when the feed runs low.
# Off unless enabled; leave it off locally (the devnet faucet key is shared with production).
# HOUSE_RAIN_ENABLED=1
# HOUSE_RAIN_MIN_LIVE=2
# HOUSE_RAIN_TSKR=88000000
# HOUSE_RAIN_SHARES=24
# HOUSE_RAIN_EVERY_MIN=30
# HOUSE_RAIN_MIN_SOL_LAMPORTS=500000000
